# Relay Operator Console web(WEB-UX-01 阶段六;由 deploy/relay-web.service.template 安装)
[Unit]
Description=Relay Operator Console (web, LAN-only bind)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/dev/relay
EnvironmentFile=/home/ubuntu/.relay/console/env
ExecStart=/usr/bin/env node src/server/index.ts
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
